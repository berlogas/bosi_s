# ---- boasi_s: общие настройки ----
APP_NAME=boasi_s
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:80","http://127.0.0.1","http://localhost","http://127.0.0.1:80"]

# ---- безопасность ----
# ОБЯЗАТЕЛЬНО замените: сгенерируйте командой
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Приложение не стартует с коротким или шаблонным ключом.
SECRET_KEY=change-me-please-generate-48-bytes
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- хранилище ----
# dev: путь внутри проекта; prod: /data (том Docker)
DATA_DIR=./data
# DATABASE_URL=sqlite:////data/boasi.sqlite3
PQA_HOME=
UPLOAD_MAX_MB=200

# ---- LLM / эмбеддинги (единственное, что меняется при переходе в бой) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=ollama/qwen2.5:3b
# Сводки контекста той же слабой моделью искажают ответы: поставьте сюда
# более сильную модель (например, ollama/qwen2.5:14b-instruct), чтобы
# сводка не «пересказывала» документ ошибками.
SUMMARY_LLM_MODEL=
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1
LLM_TIMEOUT_SECONDS=3600
LLM_MAX_RETRIES=2
EVIDENCE_K=10
# Источников в самом ответе: больше = больше материала, который модель
# может проверить против контекста (стоимость — только prefill).
ANSWER_MAX_SOURCES=8
# Короткий ответ: простыня в стиле научной статьи провоцирует
# выдуманные факты (см. app/services/grounding.py).
ANSWER_LENGTH=no more than 120 words
# Сырой текст вместо LLM-сводок: честнее, но огромный prefill
# (замер SPICE_REPORT §3.3: ответ 817 с) — включать осознанно.
EVIDENCE_SKIP_SUMMARY=false
MAX_CONCURRENT_REQUESTS=1
CHUNK_CHARS=4000
CHUNK_OVERLAP=200
OFFLINE_MODE=true
MULTIMODAL=false
# Русскоязычная инструкция (копия docs/SPICE_REPORT.md §7)
PROMPTS_SYSTEM=
# Шаблон qa-промпта: пусто = дефолт paperqa + GROUNDING RULES
PROMPTS_QA=

# ---- лимиты и жизненный цикл сессий (ТЗ) ----
SESSION_TTL_DAYS=90
HEARTBEAT_INTERVAL_MINUTES=5
ARCHIVE_RETENTION_DAYS=30
MAX_SESSIONS_PER_USER=10
MAX_DOCUMENTS_PER_SESSION=50
MAX_SESSION_STORAGE_MB=500
MAX_PROJECTS_PER_SESSION=5

# ---- фоновая обработка ----
INDEXER_CONCURRENCY=1

# ---------- безопасность (Фаза 9) ----------
# Разрешить импорт документов вне каталога данных. По умолчанию выключено:
# исследователь загружает только из каталога своей сессии.
ALLOW_EXTERNAL_IMPORT_PATHS=false
# Защита от перебора пароля на /api/auth/login
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
MIN_SECRET_KEY_LENGTH=32
BACKGROUND_POLL_SECONDS=2.0

# Язык ответов (ru | en); пусто = правило языка не добавляется
ANSWER_LANGUAGE=ru

# Кэш моделей. В контейнере лежит ВНУТРИ тома данных (/data/hf, /data/torch),
# поэтому обычный сброс состояния его не трогает: иначе оффлайн-контур
# останется без модели эмбеддингов. Удалить можно только явным --include-models.
# HF_HOME=/data/hf
# TORCH_HOME=/data/torch

# Разрешить разрушающий сброс состояния в prod (make reset-data и кнопка
# «Сброс» в админке). По умолчанию выключено: сброс удаляет документы,
# сессии и сообщения безвозвратно.
ALLOW_DESTRUCTIVE_RESET=false

# ---- первый вход (только если регистрации в UI нет) ----
# Используются скриптом scripts/bootstrap.sh при первичной установке.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ---- резервное копирование ----
# Куда складывать копии (создаётся из админки: вкладка «Обслуживание»).
# ВАЖНО: каталог должен быть ВНЕ DATA_DIR, иначе копия попадёт сама в себя.
# В Docker это отдельный том /backups, здесь — backups/ в корне проекта.
# BACKUP_DIR=./backups
# Сколько копий хранить (0 — без ограничения). Более старые удаляются
# автоматически после создания новой.
# BACKUP_KEEP=14
